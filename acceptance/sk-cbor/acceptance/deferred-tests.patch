+            assert_eq!(Value::from(n).extract_unsigned(), Some(n as u64));
+        }
+        for n in [i64::MIN, -1, 0, i64::MAX] {
+            assert_eq!(Value::from(n).extract_integer(), Some(n as i64));
+        }
+        for n in [i32::MIN, -1, 0, i32::MAX] {
+            assert_eq!(Value::from(n).extract_integer(), Some(n as i64));
+        }
+        for n in [i16::MIN, -1, 0, i16::MAX] {
+            assert_eq!(Value::from(n).extract_integer(), Some(n as i64));
+        }
+        for n in [i8::MIN, -1, 0, i8::MAX] {
+            assert_eq!(Value::from(n).extract_integer(), Some(n as i64));
+        }
+    }
+
+    #[test]
+    fn test_from_array() {
+        assert_eq!(
+            Value::from(vec![Value::unsigned(0)]).extract_array(),
+            Some(vec![Value::unsigned(0)])
+        );
+    }
+
+    #[test]
+    fn test_from_map() {
+        extern crate std;
+        let pairs = vec![
+            (Value::unsigned(1), Value::unsigned(2)),
+            (Value::unsigned(0), Value::unsigned(3)),
+        ];
+        assert_eq!(
+            Value::from(pairs).extract_map(),
+            Some(vec![
+                (Value::unsigned(0), Value::unsigned(3)),
+                (Value::unsigned(1), Value::unsigned(2)),
+            ])
+        );
+        assert!(
+            std::panic::catch_unwind(|| Value::from(vec![
+                (Value::unsigned(0), Value::unsigned(1)),
+                (Value::unsigned(0), Value::unsigned(2)),
+            ]))
+            .is_err()
+        );
+    }
+}
